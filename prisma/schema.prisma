generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  password  String
  createdAt DateTime @default(now())

  orders    Order[]
  workflows Workflow[]

  @@map("users")
}

model Order {
  id        String      @id @default(uuid())
  amount    Float
  status    OrderStatus @default(PENDING)
  createdAt DateTime    @default(now())

  userId String
  user   User   @relation(fields: [userId], references: [id])

  @@map("orders")
}

enum OrderStatus {
  PENDING
  PAID
  CANCELLED
}

model Workflow {
  id       String      @id @default(uuid())
  name     String
  trigger  TriggerType
  isActive Boolean     @default(true)

  condition Json?

  createdAt DateTime @default(now())

  userId String
  user   User   @relation(fields: [userId], references: [id])

  actions    WorkflowAction[]
  executions WorkflowExecution[]

  @@map("workflows")
}

enum TriggerType {
  USER_REGISTERED
  ORDER_CREATED
  ORDER_PAID
  MANUAL
}

model WorkflowAction {
  id     String     @id @default(uuid())
  type   ActionType
  order  Int
  params Json?

  workflowId String
  workflow   Workflow @relation(fields: [workflowId], references: [id], onDelete: Cascade)

  @@map("workflow_actions")
}

enum ActionType {
  NOTIFY_ADMIN
  NOTIFY_USER
  CREATE_LOG
  CREATE_TASK
  UPDATE_STATUS
}

model WorkflowExecution {
  id         String          @id @default(uuid())
  status     ExecutionStatus
  startedAt  DateTime        @default(now())
  finishedAt DateTime?
  context    Json?

  workflowId String
  workflow   Workflow @relation(fields: [workflowId], references: [id], onDelete: Cascade)

  actionResults ActionResult[]

  @@map("workflow_executions")
}

enum ExecutionStatus {
  RUNNING
  SUCCESS
  FAILED
}

model ActionResult {
  id         String       @id @default(uuid())
  actionType ActionType
  status     ResultStatus
  order      Int
  output     String?
  executedAt DateTime     @default(now())

  executionId String
  execution   WorkflowExecution @relation(fields: [executionId], references: [id], onDelete: Cascade)

  @@map("action_results")
}

enum ResultStatus {
  SUCCESS
  FAILED
}

model Task {
  id          String   @id @default(uuid())
  title       String
  description String?
  createdAt   DateTime @default(now())

  @@map("tasks")
}
