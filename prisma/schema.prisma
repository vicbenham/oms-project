generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────────
// USER
// Un utilisateur possède des commandes et des workflows
// ─────────────────────────────────────────────
model User {
  id        String   @id @default(uuid())
  email     String   @unique
  password  String // stocké hashé via bcrypt (jamais en clair)
  createdAt DateTime @default(now())

  orders    Order[]
  workflows Workflow[]

  @@map("users")
}

// ─────────────────────────────────────────────
// ORDER
// Une commande appartient à un utilisateur
// Elle déclenche l'événement order.created
// ─────────────────────────────────────────────
model Order {
  id        String      @id @default(uuid())
  amount    Float
  status    OrderStatus @default(PENDING)
  createdAt DateTime    @default(now())

  userId String
  user   User   @relation(fields: [userId], references: [id])

  @@map("orders")
}

enum OrderStatus {
  PENDING
  PAID
  CANCELLED
}

// ─────────────────────────────────────────────
// WORKFLOW
// Un workflow = un trigger + une liste d'actions ordonnées
// Il appartient à un utilisateur et peut être actif/inactif
// ─────────────────────────────────────────────
model Workflow {
  id       String      @id @default(uuid())
  name     String
  trigger  TriggerType
  isActive Boolean     @default(true)

  condition Json?

  createdAt DateTime @default(now())

  userId String
  user   User   @relation(fields: [userId], references: [id])

  actions    WorkflowAction[]
  executions WorkflowExecution[]

  @@map("workflows")
}

// Les triggers disponibles dans le système
enum TriggerType {
  USER_REGISTERED // déclenché à l'inscription
  ORDER_CREATED // déclenché à la création d'une commande
  ORDER_PAID // déclenché quand une commande passe à PAID
  MANUAL // déclenché manuellement via un endpoint
}

// ─────────────────────────────────────────────
// WORKFLOW ACTION
// Une action appartient à un workflow
// Elle a un type et un ordre d'exécution
// Elle peut avoir des paramètres optionnels (ex: URL pour call_webhook)
// ─────────────────────────────────────────────
model WorkflowAction {
  id     String     @id @default(uuid())
  type   ActionType
  order  Int // détermine l'ordre d'exécution séquentielle
  params Json? // paramètres optionnels spécifiques à l'action

  workflowId String
  workflow   Workflow @relation(fields: [workflowId], references: [id], onDelete: Cascade)

  @@map("workflow_actions")
}

// Les types d'actions disponibles
enum ActionType {
  NOTIFY_ADMIN // notifie l'admin (log en base)
  NOTIFY_USER // notifie l'utilisateur (log en base)
  CREATE_LOG // crée une entrée de log
  CREATE_TASK // crée une tâche en base
  UPDATE_STATUS // met à jour le statut d'une commande
}

// ─────────────────────────────────────────────
// WORKFLOW EXECUTION
// Historique de chaque exécution d'un workflow
// Permet l'observabilité (US12)
// ─────────────────────────────────────────────
model WorkflowExecution {
  id         String          @id @default(uuid())
  status     ExecutionStatus
  startedAt  DateTime        @default(now())
  finishedAt DateTime?

  // Contexte de l'événement qui a déclenché l'exécution (sérialisé en JSON)
  // Ex: { orderId: "...", amount: 150 }
  context Json?

  workflowId String
  workflow   Workflow @relation(fields: [workflowId], references: [id])

  actionResults ActionResult[]

  @@map("workflow_executions")
}

enum ExecutionStatus {
  RUNNING
  SUCCESS
  FAILED
}

// ─────────────────────────────────────────────
// ACTION RESULT
// Résultat de chaque action dans une exécution
// Permet de savoir exactement quelle action a réussi ou échoué
// ─────────────────────────────────────────────
model ActionResult {
  id         String       @id @default(uuid())
  actionType ActionType
  status     ResultStatus
  order      Int // ordre dans lequel l'action a été exécutée
  output     String? // message de succès ou d'erreur
  executedAt DateTime     @default(now())

  executionId String
  execution   WorkflowExecution @relation(fields: [executionId], references: [id], onDelete: Cascade)

  @@map("action_results")
}

enum ResultStatus {
  SUCCESS
  FAILED
}

// ─────────────────────────────────────────────
// TASK
// Créée par l'action CREATE_TASK
// ─────────────────────────────────────────────
model Task {
  id          String   @id @default(uuid())
  title       String
  description String?
  createdAt   DateTime @default(now())

  @@map("tasks")
}
